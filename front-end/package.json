{
  "name": "avasan-front-end",
  "type": "module",
  "version": "1.2.23",
  "private": true,
  "description": "The avasan.org teaching homepage",
  "author": "Jacob Anderson",
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "build": "nuxt generate && node scripts/install-branded-404.mjs && node ../scripts/write-release-metadata.mjs",
    "dev": "nuxt dev --port 3333 --open",
    "start": "nuxt dev --port 3333 --open --host",
    "serve": "nuxt dev --port 3333 --open --host",
    "preview": "cd .. && node scripts/static-preview-server.mjs",
    "preview-https": "cd .. && node scripts/static-preview-server.mjs --https",
    "typecheck": "nuxt typecheck",
    "up": "taze major -I",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prepare": "nuxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.1.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@unocss/eslint-config": "^66.12.0",
    "@unocss/nuxt": "^66.12.0",
    "@unocss/preset-web-fonts": "^66.12.0",
    "@vitejs/devtools": "0.8.2",
    "@vitejs/devtools-kit": "0.8.2",
    "@vue/compiler-sfc": "^3.5.45",
    "c12": "^3.3.4",
    "nuxt": "^4.6.4",
    "unocss": "^66.12.0",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.14"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
